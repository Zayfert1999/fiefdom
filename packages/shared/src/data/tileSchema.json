{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Fiefdom Tile Set",
  "type": "object",
  "required": ["tiles"],
  "properties": {
    "tiles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "quantity", "features"],
        "properties": {
          "id": { "type": "string" },
          "quantity": { "type": "integer", "minimum": 1 },
          "features": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "type", "ports", "meepleSpot"],
              "properties": {
                "id": { "type": "string" },
                "type": { "enum": ["road", "city", "monastery", "field"] },
                "ports": {
                  "type": "array",
                  "items": { "type": "integer", "minimum": 0, "maximum": 11 }
                },
                "meepleSpot": { "$ref": "#/definitions/spot" },
                "shieldSpot": { "$ref": "#/definitions/spot" },
                "adjacentCities": { "type": "array", "items": { "type": "string" } }
              }
            }
          }
        }
      }
    }
  },
  "definitions": {
    "spot": {
      "type": "object",
      "required": ["x", "y"],
      "properties": {
        "x": { "type": "number", "minimum": -50, "maximum": 50 },
        "y": { "type": "number", "minimum": -50, "maximum": 50 }
      }
    }
  }
}