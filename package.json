{
  "name": "fiefdom",
  "private": true,
  "version": "0.0.0",
  "description": "Fiefdom web game - monorepo",
  "scripts": {
    "dev": "turbo run dev",
    "dev:client": "turbo run dev --filter=@fiefdom/client",
    "dev:client:host": "turbo run dev --filter=@fiefdom/client -- --host",
    "dev:server": "turbo run dev --filter=@fiefdom/server",
    "build": "turbo run build",
    "build:client": "turbo run build --filter=@fiefdom/client",
    "lint": "turbo run lint",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "turbo": "^2.0.0",
    "typescript": "~5.6.0"
  },
  "packageManager": "pnpm@9.0.0"
}