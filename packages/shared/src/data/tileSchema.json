{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Fiefdom Tile Set",
  "description": "Схема для описания набора тайлов Каркассона (12-портовая система). Система координат: [-50, 50], центр тайла = (0, 0).",
  "type": "object",
  "required": ["tiles"],
  "properties": {
    "tiles": {
      "type": "array",
      "description": "Массив определений тайлов",
      "items": {
        "type": "object",
        "required": ["id", "artId", "quantity", "features"],
        "properties": {
          "id": {
            "type": "string",
            "description": "Уникальный идентификатор тайла (например, 'tile_CCFC-S')"
          },
          "artId": {
            "type": "string",
            "description": "Идентификатор графики (SVG-файл). Может совпадать с id или указывать на базовый тайл"
          },
          "quantity": {
            "type": "integer",
            "minimum": 1,
            "description": "Количество экземпляров этого тайла в колоде"
          },
          "features": {
            "type": "array",
            "minItems": 1,
            "description": "Список фич тайла (город, дорога, поле, монастырь)",
            "items": {
              "type": "object",
              "required": ["id", "type", "ports", "meepleSpot"],
              "properties": {
                "id": {
                  "type": "string",
                  "description": "Уникальный ID фичи в пределах тайла"
                },
                "type": {
                  "type": "string",
                  "enum": ["city", "road", "field", "monastery"],
                  "description": "Тип фичи"
                },
                "shieldSpot": {
                  "type": "object",
                  "required": ["x", "y"],
                  "properties": {
                    "x": { "type": "number", "minimum": -50, "maximum": 50 },
                    "y": { "type": "number", "minimum": -50, "maximum": 50 }
                  },
                  "description": "Координаты щита в системе [-50, 50] (только для городов с щитом)"
                },
                "ports": {
                  "type": "array",
                  "uniqueItems": true,
                  "description": "Порты тайла (0-11), которые занимает фича. Монастыри — пустой массив.",
                  "items": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 11
                  }
                },
                "meepleSpot": {
                  "type": "object",
                  "required": ["x", "y"],
                  "properties": {
                    "x": { "type": "number", "minimum": -50, "maximum": 50 },
                    "y": { "type": "number", "minimum": -50, "maximum": 50 }
                  },
                  "description": "ОДИН спот для размещения мипла в системе [-50, 50]"
                },
                "adjacentCities": {
                  "type": "array",
                  "items": { "type": "string" },
                  "description": "ID городов, граничащих с этим полем (только для полей)"
                }
              }
            }
          }
        }
      }
    }
  }
}