{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Fiefdom Tile Set",
  "type": "object",
  "required": ["tiles"],
  "properties": {
    "tiles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "artId", "quantity", "features"],
        "properties": {
          "features": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "type", "ports", "meepleSpot"],
              "properties": {
                "geometry": {
                  "type": "object",
                  "required": ["kind"],
                  "properties": {
                    "kind": {
                      "type": "string",
                      "enum": ["area", "line", "derived"]
                    },
                    "start": { "$ref": "#/definitions/point" },
                    "outline": { "type": "array" },
                    "lineWidth": { "type": "number", "minimum": 0 },
                    "path": { "type": "array" }
                  },
                  "allOf": [
                    {
                      "if": { "properties": { "kind": { "const": "area" } } },
                      "then": { "required": ["start", "outline"] }
                    },
                    {
                      "if": { "properties": { "kind": { "const": "line" } } },
                      "then": { "required": ["lineWidth", "start", "path"] }
                    },
                    {
                      "if": { "properties": { "kind": { "const": "derived" } } },
                      "then": { "not": { "required": ["start", "outline", "path"] } }
                    }
                  ]
                }
              }
            }
          }
        }
      }
    }
  },
  "definitions": {
    "point": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": { "type": "number", "minimum": -50, "maximum": 50 }
    }
  }
}