{
  "name": "fiefdom",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Fiefdom web game - monorepo",
  "scripts": {
    "dev": "turbo run dev",
    "dev:client": "turbo run dev --filter=@fiefdom/client",
    "dev:client:host": "turbo run dev --filter=@fiefdom/client -- --host",
    "dev:server": "turbo run dev --filter=@fiefdom/server",
    "build": "turbo run build",
    "build:client": "turbo run build --filter=@fiefdom/client",
    "lint": "turbo run lint",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "turbo": "^2.0.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.59.2"
  },
  "packageManager": "pnpm@9.0.0"
}
